# ─────────────────────────────────────────────────────────────────────────────
# ADAPT configuration. Copy to `.env` and adjust. Every value has a working default:
# with no OPENAI_API_KEY, all AI capabilities run on deterministic demo adapters.
#
# The same file serves two setups:
#   • `docker compose up`  — Compose overrides DATABASE_URL / REDIS_URL with the
#                             in-network service addresses automatically.
#   • native development   — backend/frontend run on your machine against the
#                             Compose Postgres/Redis on the host ports below.
# ─────────────────────────────────────────────────────────────────────────────

# --- runtime ------------------------------------------------------------------
ADAPT_ENV=development                 # development | test | production
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5180,http://localhost:8080

# --- security -----------------------------------------------------------------
# Development: this placeholder resolves to an installation-specific random key saved
# in DOCUMENT_STORAGE_DIR/.adapt-session-secret (shared by API and worker). Keep that file.
# Production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=dev-only-insecure-session-secret-change-me-0000
SESSION_TTL_HOURS=168
DEMO_AUTH_ENABLED=true               # must be false in production
# Fernet key for documents at rest. Production: generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_URL_TTL_SECONDS=300

# --- Postgres (pgvector) --------------------------------------------------------
POSTGRES_USER=adapt                  # schema owner: migrations + governance seeding only
POSTGRES_PASSWORD=adapt
POSTGRES_DB=adapt
APP_DB_USER=adapt_app                # runtime role: row-level security applies to it
APP_DB_PASSWORD=adapt_app
# Native development (host ports). Use 127.0.0.1, not localhost (avoids IPv6 stalls).
DATABASE_URL=postgresql+psycopg://adapt_app:adapt_app@127.0.0.1:55432/adapt
MIGRATION_DATABASE_URL=postgresql+psycopg://adapt:adapt@127.0.0.1:55432/adapt
# Integration tests (database created by infra/postgres/init)
ADAPT_TEST_DATABASE_URL=postgresql+psycopg://adapt_app:adapt_app@127.0.0.1:55432/adapt_test
ADAPT_TEST_OWNER_DATABASE_URL=postgresql+psycopg://adapt:adapt@127.0.0.1:55432/adapt_test

# --- Redis / worker ---------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:56379/0
WORKER_MAX_JOBS=8

# --- documents ----------------------------------------------------------------------
DOCUMENT_STORAGE_DIR=./var/documents
MAX_UPLOAD_BYTES=15728640

# --- OpenAI -------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_REASONING_MODEL=gpt-5.5
OPENAI_FAST_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_MODEL=gpt-5.4-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- independent human-to-human interpreter ------------------------------------------
INTERPRETER_MODE=auto                 # auto: live with key, demo UI without it
INTERPRETER_FALLBACK_ENABLED=true      # Arabic output currently needs recorded fallback
INTERPRETER_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
INTERPRETER_TRANSLATION_MODEL=gpt-5.4-mini
INTERPRETER_TTS_MODEL=gpt-4o-mini-tts

# --- adapter selection: auto (live if key present) | live (fail if no key) | demo ------
ADAPTER_LLM=auto
ADAPTER_EMBEDDINGS=auto
ADAPTER_OCR=auto
ADAPTER_VOICE=auto
ADAPTER_WEB_SEARCH=auto
# actions: auto = demo previews outside production, official handoffs in production
ADAPTER_ACTIONS=auto

# --- host ports used by docker compose --------------------------------------------------
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
BACKEND_HOST_PORT=8100
FRONTEND_HOST_PORT=8080

# --- frontend (Vite, native dev only; baked at build time) ------------------------------
# Synthetic, offline stage presentation; build with true for the hackathon only.
# Has no private API access; recorded LangGraph/reader output is explicitly labelled.
DEMO_MODE=false
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8100
VITE_SHOW_DEV_BADGE=true
# Frontend data source: auto (API where shipped, typed mocks elsewhere) | mock (no backend) | live (never mock)
VITE_DATA_MODE=auto
